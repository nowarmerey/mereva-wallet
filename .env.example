# ============================================================================
#  My Wallet — environment variables
#  Copy this file to ".env" and fill in the values.
# ============================================================================

# --- Database (PostgreSQL) ---
# Local Docker:  postgresql://wallet:wallet@localhost:5432/wallet?schema=public
# Production:    use your managed Postgres connection string (Neon, Supabase,
#               RDS, or the bundled docker-compose "db" service).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# --- Auth (NextAuth / Auth.js) ---
# NEXTAUTH_URL = your site's public URL (e.g. https://app.yourdomain.com)
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -hex 32   (or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
NEXTAUTH_SECRET="CHANGE_ME"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Google OAuth + Drive backup ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client (Web).
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
# Enable the "Google Drive API" for backups.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Stripe (online subscriptions) ---
# Leave empty to run with admin-managed subscriptions only (no online payments).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Seed admin account (used once by prisma/seed-saas.js) ---
SEED_ADMIN_EMAIL="admin@yourdomain.com"
SEED_ADMIN_PASSWORD="change-this-strong-password"

# --- Email (Resend) ---
# Used for password reset, email verification and reminders.
# Leave RESEND_API_KEY empty in dev to log emails to the server console.
RESEND_API_KEY=""
EMAIL_FROM="Mereva Wallet <noreply@yourdomain.com>"

# --- Scheduled tasks (cron) ---
# A scheduler must hit GET/POST {APP}/api/cron/run with this secret to
# auto-post due subscriptions and send reminders. Send it as either header
# "x-cron-secret", "?secret=", or "Authorization: Bearer <secret>".
CRON_SECRET="change-this-cron-secret"

# --- Web Push notifications (PWA) ---
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@yourdomain.com"

# --- Error monitoring (optional) ---
SENTRY_DSN=""
